# Copy to .env for local development. Never commit .env.

# MongoDB Atlas connection string (same value you set in Render)
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/bonuscalculator?retryWrites=true&w=majority

# Any long random string. Use a DIFFERENT value locally than in Render.
JWT_SECRET=change-me-to-a-long-random-string

# Optional; Render provides its own PORT automatically.
PORT=3000
